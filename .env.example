# Salin ke .env lalu isi nilainya, kemudian restart `pnpm dev`.
# Dapatkan Client ID di: https://console.cloud.google.com/apis/credentials
# Tipe: OAuth Client ID -> Web application
# Authorized JavaScript origins: http://localhost:5173 (dan domain produksi kamu)

VITE_GOOGLE_CLIENT_ID=
# Super-admin (penyetuju pendaftaran brand), pisahkan koma.
# Hanya email di sini yang bisa menyetujui/menolak pengajuan brand.
# Semua orang bisa login Google + mendaftarkan brand, tapi brand aktif
# setelah disetujui salah satu super-admin di bawah ini.
VITE_ADMIN_EMAILS=
